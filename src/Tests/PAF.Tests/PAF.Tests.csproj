<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>PAF.Tests</RootNamespace>
		<AssemblyName>PAF.Tests</AssemblyName>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<NoWarn>$(NoWarn);CA1515;CA1861;CA1707</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoFixture" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="NSubstitute" />
		<PackageReference Include="Shouldly" />
		<PackageReference Include="Testcontainers.Redis" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="coverlet.collector" />
		<!-- O19: the RNF05 barrier builds AWS clients to read their configured deadline. -->
		<PackageReference Include="AWSSDK.S3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Modules\PAF\Modules.PAF\Modules.PAF.csproj" />
		<!-- O07: the expand and contract barrier reads the PafDbContext migrations. -->
		<ProjectReference Include="..\..\Host\FSH.Starter.Migrations.PostgreSQL\FSH.Starter.Migrations.PostgreSQL.csproj" />
	</ItemGroup>

	<!-- O19: the RNF05 barrier evaluates the API host configuration from the host's own files. -->
	<ItemGroup>
		<Content Include="..\..\Host\FSH.Starter.Api\appsettings*.json" Link="host\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- O10: the logging tests apply the Serilog lines of the deployment environment file. -->
	<ItemGroup>
		<Content Include="..\..\..\deploy\paf\ambientes\producao.env.exemplo" Link="ambientes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- O07: the station and hub contract snapshot. -->
	<ItemGroup>
		<Content Include="Contrato\contrato-estacao.snapshot.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
