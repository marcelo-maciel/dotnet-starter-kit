<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>PAF.Tests</RootNamespace>
		<AssemblyName>PAF.Tests</AssemblyName>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<NoWarn>$(NoWarn);CA1515;CA1861;CA1707</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoFixture" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="NSubstitute" />
		<PackageReference Include="Shouldly" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
		<PackageReference Include="coverlet.collector" />
		<!-- O19: the RNF05 barrier builds AWS clients to read their configured deadline. -->
		<PackageReference Include="AWSSDK.S3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Modules\PAF\Modules.PAF\Modules.PAF.csproj" />
	</ItemGroup>

	<!-- O19: the RNF05 barrier evaluates the API host configuration from the host's own files. -->
	<ItemGroup>
		<Content Include="..\..\Host\FSH.Starter.Api\appsettings*.json" Link="host\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
