# PAF V2, project @@PROJETO@@. Generated by deploy/paf/apache/gerar-vhost.sh from the environment file: edit the
# template, never the generated copy in sites-available. One file per environment on the shared Apache of the host.
#
# Modules (deploy/paf/apache/conferir-apache.sh checks them, never enables them): ssl, proxy, proxy_http,
# proxy_balancer, slotmem_shm, lbmethod_byrequests, headers, plus mpm_event (prefork pins a process per WebSocket).
# Apache 2.4.47 or newer: `upgrade=websocket` on the member is the mod_proxy_http tunnel (ARQ seção 11).

# Never %r or %q: /api/v1/paf/hub, /api/v1/realtime/hub and /notifications carry ?access_token= (the browser cannot
# send the header on a WebSocket), so no query string reaches the log on any route of these hosts.
LogFormat "%h %t \"%m %U %H\" %>s %O %D \"%{User-Agent}i\" worker=%{BALANCER_WORKER_NAME}e" @@PROJETO@@_sem_query

<VirtualHost *:80>
    ServerName @@HOST_API@@
    ServerAlias @@HOST_DASHBOARD@@ @@HOST_ADMIN@@
    # Without this vhost a plain-HTTP request for these hosts would fall on the default vhost: another client's site.
    <Location "/">
        Redirect permanent "https://%{HTTP_HOST}%{REQUEST_URI}"
    </Location>
    ErrorLog ${APACHE_LOG_DIR}/@@PROJETO@@-error.log
    CustomLog ${APACHE_LOG_DIR}/@@PROJETO@@-access.log @@PROJETO@@_sem_query
</VirtualHost>

<VirtualHost *:443>
    ServerName @@HOST_API@@
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/@@HOST_API@@/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/@@HOST_API@@/privkey.pem

    # Option B of ARQ seção 11 (decided 17/10/2026): every PafHub client connects WebSockets-only with
    # SkipNegotiation, so plain round-robin needs no affinity cookie and a dead member fails over in one request.
    # retry: a member in error is tried again after 10 s, not the 60 s default that kept a restarted instance out
    # of the pool during the spike (ARQ l.378); the rolling deploy (O06) still drains before stopping one.
    # connectiontimeout: a member that does not accept within 3 s is skipped in the same request.
    <Proxy "balancer://@@PROJETO@@">
        BalancerMember "http://127.0.0.1:@@PORTA_API_A@@" upgrade=websocket connectiontimeout=3 retry=10
@@MEMBRO_API_B@@
        ProxySet lbmethod=byrequests
    </Proxy>

    # Above the SignalR keepalive (15 s each way, 30 s server timeout): an idle tunnel always sees a ping first.
    ProxyTimeout 60
    # The kit trusts only X-Forwarded-For and X-Forwarded-Proto (BuildingBlocks/Web/Extensions.cs), not
    # X-Forwarded-Host: the public host has to arrive as Host.
    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    ProxyPass "/" "balancer://@@PROJETO@@/"
    ProxyPassReverse "/" "balancer://@@PROJETO@@/"

    LogLevel warn
    ErrorLog ${APACHE_LOG_DIR}/@@PROJETO@@-error.log
    CustomLog ${APACHE_LOG_DIR}/@@PROJETO@@-access.log @@PROJETO@@_sem_query
</VirtualHost>

<VirtualHost *:443>
    ServerName @@HOST_DASHBOARD@@
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/@@HOST_DASHBOARD@@/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/@@HOST_DASHBOARD@@/privkey.pem
    ProxyTimeout 60
    ProxyPreserveHost On
    ProxyPass "/" "http://127.0.0.1:@@PORTA_DASHBOARD@@/" connectiontimeout=3
    ProxyPassReverse "/" "http://127.0.0.1:@@PORTA_DASHBOARD@@/"
    LogLevel warn
    ErrorLog ${APACHE_LOG_DIR}/@@PROJETO@@-error.log
    CustomLog ${APACHE_LOG_DIR}/@@PROJETO@@-access.log @@PROJETO@@_sem_query
</VirtualHost>

<VirtualHost *:443>
    ServerName @@HOST_ADMIN@@
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/@@HOST_ADMIN@@/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/@@HOST_ADMIN@@/privkey.pem
    ProxyTimeout 60
    ProxyPreserveHost On
    ProxyPass "/" "http://127.0.0.1:@@PORTA_ADMIN@@/" connectiontimeout=3
    ProxyPassReverse "/" "http://127.0.0.1:@@PORTA_ADMIN@@/"
    LogLevel warn
    ErrorLog ${APACHE_LOG_DIR}/@@PROJETO@@-error.log
    CustomLog ${APACHE_LOG_DIR}/@@PROJETO@@-access.log @@PROJETO@@_sem_query
</VirtualHost>
