# PAF V2, ambiente de homologação. Copiar para homologacao.env (fora do git) e preencher os segredos.
# Este arquivo é ao mesmo tempo o --env-file do compose e o env_file da API e do DbMigrator.
# Segredos sem o caractere $ (o compose o interpola; verificar-ambiente.sh reprova o aviso de variável ausente).

# --- Projeto, rede e portas (só o compose lê) ---
COMPOSE_PROJECT_NAME=paf-homologacao
# Homologação opera com uma instância (ARQ l.369).
COMPOSE_PROFILES=
PAF_ARQUIVO_AMBIENTE=ambientes/homologacao.env
PAF_SUBNET=172.31.20.0/24
PAF_PORTA_POSTGRES=25432
PAF_PORTA_API_A=28080
PAF_PORTA_API_B=28081
PAF_PORTA_DASHBOARD=28082
PAF_PORTA_ADMIN=28083
PAF_IMAGEM_API=paf-api:<tag>
PAF_IMAGEM_MIGRATOR=paf-dbmigrator:<tag>
PAF_IMAGEM_DASHBOARD=paf-dashboard:<tag>
PAF_IMAGEM_ADMIN=paf-admin:<tag>
POSTGRES_PASSWORD=<segredo>
VALKEY_PASSWORD=<segredo>
PAF_API_URL=https://api.homolog.paf.exemplo.com.br
PAF_DASHBOARD_URL=https://homolog.paf.exemplo.com.br
PAF_ADMIN_URL=https://admin.homolog.paf.exemplo.com.br
PAF_TENANT_PADRAO=root
# D04: prazo único da ordem de um turno (8 h) para todas as telas do dashboard.
PAF_INATIVIDADE_MS=28800000

# --- Host .NET (API e DbMigrator) ---
DOTNET_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
TZ=America/Sao_Paulo
# GSS desligado: a imagem noble não tem libgssapi_krb5 e o Npgsql registra a falha a cada conexão.
DatabaseOptions__ConnectionString=Host=postgres;Database=fsh;Username=fsh;Password=${POSTGRES_PASSWORD};Timeout=15;Command Timeout=30;GSS Encryption Mode=Disable
CachingOptions__Redis=valkey:6379,password=${VALKEY_PASSWORD},connectTimeout=5000,syncTimeout=5000,asyncTimeout=5000
# ASCII, 32 caracteres ou mais, diferente da produção.
JwtOptions__SigningKey=replace-with-a-random-ascii-key-of-64-chars
# Igual nos dois ambientes: a homologação ensaia o prazo de produção (ARQ l.330).
JwtOptions__AccessTokenMinutes=60
QuotaOptions__Enabled=false
TrustedProxyOptions__KnownNetworks__0=${PAF_SUBNET}
CorsOptions__AllowedOrigins__0=${PAF_DASHBOARD_URL}
CorsOptions__AllowedOrigins__1=${PAF_ADMIN_URL}
CorsOptions__AllowedHeaders__0=content-type
CorsOptions__AllowedHeaders__1=authorization
CorsOptions__AllowedHeaders__2=tenant
CorsOptions__AllowedHeaders__3=x-fsh-app
CorsOptions__AllowedHeaders__4=idempotency-key
CorsOptions__AllowedHeaders__5=x-requested-with
CorsOptions__AllowedHeaders__6=x-signalr-user-agent
CorsOptions__AllowedHeaders__7=if-match
CorsOptions__AllowedHeaders__8=x-paf-unidade
FrontendOptions__AllowedOrigins__0=${PAF_DASHBOARD_URL}
FrontendOptions__AllowedOrigins__1=${PAF_ADMIN_URL}
FrontendOptions__DefaultOrigin=${PAF_DASHBOARD_URL}
AllowedHosts=*
Storage__Provider=s3
Storage__S3__ServiceUrl=https://<account-id>.r2.cloudflarestorage.com
Storage__S3__Region=auto
Storage__S3__ForcePathStyle=true
Storage__S3__Bucket=paf-homologacao
Storage__S3__AccessKey=<segredo>
Storage__S3__SecretKey=<segredo>
HangfireOptions__UserName=<usuario>
HangfireOptions__Password=<segredo>
Seed__DefaultAdminPassword=<segredo>
MailOptions__From=no-reply@paf.exemplo.com.br
MailOptions__Smtp__Host=<smtp>
MailOptions__Smtp__Port=587
MailOptions__Smtp__Security=StartTls
MailOptions__Smtp__UserName=<usuario>
MailOptions__Smtp__Password=<segredo>

# --- Backup diário (O11, RNF14): bucket de backup do R2 deste ambiente, separado do bucket da aplicação ---
# Token de objeto com leitura e escrita só neste bucket; o bloqueio de 7 dias é passo humano (README).
PAF_IMAGEM_BACKUP=paf-backup:<tag>
PAF_BACKUP_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
PAF_BACKUP_BUCKET=paf-backup-homologacao
PAF_BACKUP_ACCESS_KEY=<segredo>
PAF_BACKUP_SECRET_KEY=<segredo>
# Webhook que recebe {"text": "..."} em toda falha do backup ou do teste de restauração.
PAF_BACKUP_ALERTA_URL=https://<webhook-de-alerta>
